# backend (read from environment; none are secrets)
EMBEDDING_BACKEND=auto            # auto | sbert | tfidf  (tfidf = offline fallback)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# frontend (only needed if the API is not on the same origin / Vite proxy)
VITE_API_URL=
